# Database
DATABASE_URL=postgresql://user:password@localhost:5432/checkonchess

# Server
PORT=3000
NODE_ENV=development

# IMPORTANT: On Railway, set BASE_URL to https://api.checkonchess.com
# Do NOT leave it as localhost:3000 in production!
BASE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3001

# OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# JWT
JWT_SECRET=change-me-in-production

# Email (SMTP) — use Resend, Mailgun, or any SMTP provider
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=resend
SMTP_PASS=your_resend_api_key
SMTP_FROM=noreply@checkonchess.com

# LLM (OpenRouter) — required for agent personality & LLM-powered moves
# Get key from https://openrouter.ai/keys
OPENROUTER_API_KEY=
